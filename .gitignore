# RUNTIME ARTIFACTS ----
# логи движка (Logger пишет в <app>/logs), дампы SGSL-транслятора,
# кадры смоук-теста и отчёт краш-хендлера — создаются при каждом запуске
logs/
SGSLETranslatorOutputDebug/
# дамп вулканизатора и SPIR-V: SGShadersTest --spirv пишет его в текущий каталог
vulkanized/
# дамп HLSL с SG_DX_DUMP_HLSL=1
DX12HLSLOutputDebug/
smoke_*.png
# ...кроме коммитнутых эталонов: они не мусор запуска, а входные данные теста
!Tests/Smoke/references/smoke_*.png
last_crash.log
# Кадры, снятые при отладке бэкендов: смоук-тест и прочие тесты пишут --output
# в текущий каталог, поэтому дампы оседают в корне репозитория (так туда попали
# geom_*.png). В корне нет ни одной осмысленной картинки, так что правило
# привязано к корню и не задевает ресурсы и картинки документации.
/*.png
# захваты RenderDoc
/captures/
